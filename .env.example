# Copia este archivo a .env.local y completa con tus propias claves.
# (Supabase: Project Settings > API)

# --- Públicas (van al navegador, no son secretas) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Secretas (SOLO servidor — nunca llegan al navegador) ---
# La "secret key" de Supabase (sb_secret_...). Con esta, el servidor puede leer y escribir
# saltándose las restricciones públicas — por eso jamás debe ir en el navegador ni a GitHub.
SUPABASE_SECRET_KEY=sb_secret_...

# Clave para firmar las sesiones. Genera una larga y aleatoria (ver README).
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
